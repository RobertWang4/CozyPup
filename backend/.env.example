DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cozypup
# Main chat model (LiteLLM id) — DeepSeek V4.1 Flash
MODEL=deepseek/deepseek-flash
MODEL_API_BASE=
MODEL_API_KEY=
# Emergency model — more capable model for safety-critical responses; may use a separate gateway
EMERGENCY_MODEL=openai/gpt-5
EMERGENCY_MODEL_API_BASE=
EMERGENCY_MODEL_API_KEY=
# Optional vision model for image turns (defaults to MODEL when empty)
VISION_MODEL=
VISION_MODEL_API_BASE=
VISION_MODEL_API_KEY=
# Optional nano emergency classifier sidecar (llama-server); empty disables it
EMERGENCY_CLF_URL=
EMERGENCY_CLF_TIMEOUT_MS=300
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
GOOGLE_PLACES_API_KEY=
# GCS bucket for avatars/photos (optional locally)
GCS_BUCKET=
# Volcengine Doubao streaming ASR (optional; speech input disabled without these)
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# Deployment environment. "dev" enables the unsafe dev endpoints (/api/v1/auth/dev*,
# /api/v1/admin/auth/dev-login, /debug/test-error). Anything else — including an
# unset value — is treated as production, where those routes return 404 and the
# server refuses to boot with the placeholder JWT_SECRET above.
APP_ENV=dev

# Comma-separated CORS allowlist, e.g. https://app.cozypup.com,https://cozypup.com
# Empty with APP_ENV=dev falls back to "*" without credentials.
# Empty in production means no cross-origin access at all.
CORS_ORIGINS=

# APNs Push Notifications (optional — runs in simulated mode without these)
APNS_KEY_PATH=          # Path to .p8 key file from Apple Developer
APNS_KEY_ID=            # 10-char Key ID
APNS_TEAM_ID=           # Apple Developer Team ID
APNS_BUNDLE_ID=com.cozypup.app
APNS_USE_SANDBOX=true
